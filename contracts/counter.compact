pragma language_version >= 0.23.0;

import CompactStandardLibrary;

// ═══════════════════════════════════════════════════════════════════
//  PRIVACY MODEL — PUBLIC vs PRIVATE
//
//  PUBLIC (on-chain, visible to anyone):
//    • `total`     — the running total. Every increment is reflected
//                    here and anyone can read it at any time.
//    • `lastNote`  — an optional short message the caller deliberately
//                    publishes via disclose().
//
//  PRIVATE (private witness, never on-chain):
//    • `secretDelta` — the amount a caller adds. It is passed into the
//      circuit as a witness, validated by ZK range checks, and used in
//      the sum. Its value is NEVER written to the ledger, never returned
//      from a circuit, and never disclosed.
//
//  PROVED WITHOUT REVEALING:
//    • That the caller contributed a valid amount between 1 and
//      MAX_DELTA inclusive, without publishing what that amount is.
//      The zero-knowledge proof attests to the bounded arithmetic; the
//      raw witness stays local to the prover's machine.
//
//  disclose() is used deliberately ONLY for the two PUBLIC values
//  (the updated total and the optional note). The private witness
//  is deliberately never wrapped in disclose().
// ═══════════════════════════════════════════════════════════════════

export ledger total: Uint<64>;
export ledger lastNote: Opaque<"string">;

// Pure read — no state change. Returns the public total.
export circuit readTotal(): Uint<64> {
    return total;
}

// Add a PRIVATE delta in [1, MAX_DELTA] to the public total and
// optionally publish a public note.
export circuit increment(secretDelta: Uint<64>, publicNote: Opaque<"string">): [] {
    const MAX_DELTA: Uint<64> = 10;

    // ZK range checks over the private witness. If these hold, the
    // prover has proven the delta was valid — observers still do not
    // learn the delta itself.
    assert(secretDelta >= 1, "Delta must be at least 1");
    assert(secretDelta <= MAX_DELTA, "Delta exceeds MAX_DELTA");

    // Deliberate disclosure of the two PUBLIC values only.
    total = disclose((total + secretDelta) as Uint<64>);
    lastNote = disclose(publicNote);
}
